{
  "name": "supaworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "build": "npm run runtime:prepare && vite build && node scripts/deployment-files.mjs && node scripts/compress.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run check && npm run format:check",
    "runtime:pack": "node scripts/runtime-distribution.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.72.0",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "svelte": "5.57.3",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "bits-ui": "^2.21.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "sharp": "0.35.5",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
